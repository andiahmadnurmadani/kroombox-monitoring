# Kroombox Monitor — runtime settings.
# Servers, NAS and websites are added in the web UI, not here.
#
# Development: copy to .env.local.  systemd install: /etc/kroombox-monitor/kroombox-monitor.env

# HTTP port and listen address. Use 127.0.0.1 when only a reverse proxy /
# Cloudflare Tunnel on the same machine should reach the dashboard.
PORT=3400
BIND_ADDRESS=0.0.0.0

# Where monitors, hosts (with SSH credentials), login and logo are stored.
# Default: ./data
# DATA_DIR=/var/lib/kroombox-monitor

# true when behind a reverse proxy / Cloudflare Tunnel: the login rate limit then
# uses CF-Connecting-IP / X-Real-IP / X-Forwarded-For instead of the proxy's address.
# Leave false when the app is exposed directly (those headers could be forged).
TRUST_PROXY=false

# First start only (when DATA_DIR/auth.json does not exist yet). Without
# ADMIN_PASSWORD a random password is generated and printed to the log once.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Default name shown before one is set in Settings.
# APP_NAME=Kroombox Monitoring
